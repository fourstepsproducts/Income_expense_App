# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For local MongoDB: mongodb://localhost:27017/finance_tracker
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/finance_tracker?retryWrites=true&w=majority
# If left empty in development/test, an embedded in-memory MongoDB will be automatically provisioned for frictionless local setup!
MONGODB_URI=mongodb://localhost:27017/finance_tracker

# JWT Secrets (replace with long, random, secure strings in production)
JWT_ACCESS_SECRET=super_secure_access_secret_key_change_in_production_98374
JWT_REFRESH_SECRET=super_secure_refresh_secret_key_change_in_production_19283
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_ORIGIN=*
