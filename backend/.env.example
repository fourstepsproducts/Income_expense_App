# Server Configuration
PORT=5010
NODE_ENV=development

# Database Configuration (VPS MongoDB or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/income_expense_db

# JWT Secrets (replace with long, random, secure strings in production)
JWT_ACCESS_SECRET=super_secure_access_secret_key_change_in_production_98374
JWT_REFRESH_SECRET=super_secure_refresh_secret_key_change_in_production_19283
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_ORIGIN=*
